# Copy to .env.docker and fill in. Never commit the filled-in file.

# Generate with:  openssl rand -base64 48
# The app refuses to start in prod if this is left as the development default.
CAMPUSCONNECT_JWT_SECRET=

DATABASE_USER=campusconnect
DATABASE_PASSWORD=

# The first administrator, created on an empty database. Production seeds no
# demo data, so without this there is no account that can add a university —
# and without a university nobody can sign up. Password must be 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the browser reaches the application. Locally the default below; in
# production your real HTTPS domain. Verification links are built from it.
PUBLIC_URL=http://localhost:8080
