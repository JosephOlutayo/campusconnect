# Copy to .env.docker and fill in. Never commit the filled-in file.

# Generate with:  openssl rand -base64 48
# The API refuses to start in prod if this is left as the development default.
CAMPUSCONNECT_JWT_SECRET=

DATABASE_USER=campusconnect
DATABASE_PASSWORD=

# Where the browser reaches each service. Locally these are the defaults below;
# in production they are your real HTTPS domains.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
