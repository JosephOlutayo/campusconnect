# Java / Maven
api/target/
*.class

# The local H2 database. Holds real accounts and password hashes — this must
# never leave the machine, which is why it is ignored rather than committed.
api/data/

# Environment files. `.env*` rather than `.env` so a variant like .env.docker
# cannot slip through carrying the JWT secret and the database password.
.env*
# ...but the templates carry no secrets and a clone needs them.
!.env.example
!.env.docker.example

# Local database dumps — never commit data
backups/

# misc
.DS_Store
*.pem
